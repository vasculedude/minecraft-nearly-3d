/* =========================================
   Paper Minecraft 3D
   Phase 1 Styles
========================================= */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html,
body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #87ceeb;
    font-family: Arial, Helvetica, sans-serif;
}

canvas {
    display: block;
    width: 100vw;
    height: 100vh;
}

/* =========================================
   Loading Screen
========================================= */

#loading-screen {
    position: fixed;
    inset: 0;

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;

    background: rgba(0,0,0,0.9);
    color: white;

    z-index: 1000;
    cursor: pointer;
}

#loading-screen h1 {
    font-size: 48px;
    margin-bottom: 12px;
}

#loading-screen p {
    font-size: 18px;
    opacity: 0.8;
}

/* =========================================
   Crosshair
========================================= */

#crosshair {
    position: fixed;

    left: 50%;
    top: 50%;

    transform: translate(-50%, -50%);

    color: white;
    font-size: 28px;
    font-weight: bold;

    pointer-events: none;
    user-select: none;

    text-shadow:
        0 0 5px black,
        0 0 10px black;

    z-index: 100;
}

/* =========================================
   HUD
========================================= */

#hud {
    position: fixed;
    inset: 0;

    pointer-events: none;

    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    z-index: 50;
}

/* =========================================
   Hotbar
========================================= */

#hotbar {
    display: flex;

    justify-content: center;
    align-items: center;

    gap: 6px;

    margin-bottom: 18px;
}

.slot {
    width: 54px;
    height: 54px;

    background: rgba(0,0,0,0.45);

    border: 2px solid rgba(255,255,255,0.35);

    color: white;

    display: flex;
    justify-content: center;
    align-items: center;

    font-weight: bold;

    backdrop-filter: blur(3px);
}

.slot.selected {
    border: 3px solid white;

    transform: scale(1.08);

    box-shadow:
        0 0 8px rgba(255,255,255,0.8);
}

/* =========================================
   Stats
========================================= */

#stats {
    position: fixed;

    left: 15px;
    top: 15px;

    color: white;

    text-shadow:
        0 0 5px black,
        0 0 10px black;
}

#health {
    font-size: 24px;
    margin-bottom: 8px;
}

#debug {
    font-size: 14px;
    opacity: 0.9;
}

/* =========================================
   Hidden UI
========================================= */

.hidden {
    display: none !important;
}
